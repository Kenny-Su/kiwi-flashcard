PORT=8002
NODE_ENV=production
DATABASE_PATH=/app/data/flashcards.db

# Replace these with the production Kiwi API/JWKS endpoints.
KIWI_API_URL=https://your-kiwi-api.example
KIWI_JWKS_URL=https://your-kiwi-api.example/.well-known/jwks.json
KIWI_JWT_SECRET=

FLASHCARD_APP_URL=https://flashcard.apps.kiwiai.org

# Needed only while registering the app. Remove it from the runtime file after
# registration succeeds.
FLASHCARD_REGISTRATION_SECRET=

# Include the public flashcard URL and the production Kiwi web origin.
CORS_ORIGINS=https://flashcard.apps.kiwiai.org,https://your-kiwi-web.example
